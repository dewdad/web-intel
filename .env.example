# SearXNG instance URL — default port 9871 (chosen to avoid conflicts with common services).
# Uses 127.0.0.1 (not localhost) to avoid IPv6/wslrelay interception on Windows/WSL systems.
# If your container runs on a different port, web-intel auto-detects it via docker inspect.
# Set SEARXNG_HOST_PORT in this file to change the docker-compose host port.
SEARXNG_URL=http://127.0.0.1:9871
# SEARXNG_HOST_PORT=9871
# SEARXNG_API_KEY=

# How web-intel resolves the SearXNG backend. Default: auto.
#   auto     — probe SEARXNG_URL; if loopback and unreachable, try Docker (wrs-searxng)
#   public   — SEARXNG_URL is a community instance. Skip Docker entirely.
#   docker   — only use the local Docker container (legacy strict mode)
#   disabled — never use SearXNG; go straight to Brave/ddgs fallback
# Quick switch to a community instance (zero infra, but rate-limited / may block bots):
#   web-intel setup --searxng-public               # auto-pick from a curated list
#   web-intel setup --searxng-public https://searx.be   # pin a specific instance
# SEARXNG_MODE=auto

# Crawl4AI Docker server (optional, for --docker mode)
CRAWL4AI_DOCKER_URL=http://localhost:11235
# CRAWL4AI_API_KEY=

# HTTP settings
HTTP_TIMEOUT=30
MAX_CONCURRENT_FETCHES=5

# Logging: DEBUG, INFO, WARNING, ERROR
# WRS_LOG_LEVEL=WARNING

# Custom User-Agent (optional)
# USER_AGENT=

# Optional: Brave Search API key for a higher-quality keyed fallback before ddgs
# BRAVE_API_KEY=
